;;; Barnsley Fern — 5 mm
;;; IFS fractal: three affine maps applied recursively.
;;;   f2 (main):   85 % scale,  +3 ° tilt, up 16 %   — full depth
;;;   f3 (left):   31 % scale, +49 ° tilt, up 16 %   — depth - 2
;;;   f4 (right):  31 % scale, -50 ° tilt, up  4 %   — depth - 2
;;; Size cutoff at 0.08 mm prevents degenerate geometry.

(defvar *resolution* 12)

;; ── pinna ──────────────────────────────────────────────────
;; A single leaflet: slim teardrop standing along Z.
(defun pinna (len)
  (let* ((w (* len 0.35))
         (profile (polygon (list 0 0)
                           (list w         (* len 0.3))
                           (list (* w 0.7) (* len 0.7))
                           (list 0           len)
                           (list (* w -0.7) (* len 0.7))
                           (list (- w)       (* len 0.3)))))
    (rotate :shape (extrude :profile profile :height (* len 0.025))
            :axis :x :angle #a(90 :deg))))

;; ── barnsley ───────────────────────────────────────────────
;; Recursive IFS fern.
;;   Main branch gets full depth; side branches get (depth - 2)
;;   to keep the tree manageable while preserving self-similarity.
(defun barnsley (depth size)
  (if (or (<= depth 0) (< size 0.08))
    (pinna (max size 0.08))
    (let* ((seg (* size 0.16))
           (side-depth (max 0 (- depth 2)))
           ;; f1 — stem segment
           (stem (translate :shape (cylinder :radius (* size 0.007)
                                             :height seg)
                            :by (list 0 0 (/ seg 2))))
           ;; f2 — main continuation (85 %, slight tilt)
           (f2 (translate
                 :shape (rotate :shape (barnsley (- depth 1) (* size 0.85))
                                :axis :y :angle #a(2.7 :deg))
                 :by (list 0 0 seg)))
           ;; f3 — left branch (31 %, 49° outward)
           (f3 (translate
                 :shape (rotate :shape (barnsley side-depth (* size 0.31))
                                :axis :y :angle #a(49 :deg))
                 :by (list 0 0 seg)))
           ;; f4 — right branch (31 %, -50° outward, lower attach)
           (f4 (translate
                 :shape (rotate :shape (barnsley side-depth (* size 0.31))
                                :axis :y :angle #a(-50 :deg))
                 :by (list 0 0 (* size 0.044)))))
      (union stem f2 f3 f4))))

;; 5 mm tall, 7 levels of self-similarity on the main axis
(barnsley 7 5.0)
