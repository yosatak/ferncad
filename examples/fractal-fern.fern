;;; Recursive Fern — namesake of ferncad.
;;;
;;; A single frond: a slim rachis with 13 sickle-lanceolate pinnae arranged
;;; on alternating sides, each scaled smaller toward the tip. The pinna
;;; builder is `memoize`'d so identical sizes share the same `Arc` — the
;;; realize-stage pointer cache then reuses the tessellated mesh across
;;; every placement that `mapcar` produces.
;;;
;;; Swap the cylindrical rachis for `(sweep :path (bezier ...))` for an
;;; arched stalk; the BSP-union pass then runs noticeably longer.

(defvar *resolution* 12)

;; ── pinna: sickle-lanceolate leaflet of unit length ──────────
(defvar pinna
  (memoize
    (lambda (len)
      (let* ((w (* len 0.18))
             (profile (polygon (list 0 0)
                               (list w               (* len 0.20))
                               (list (* w 0.6)       (* len 0.55))
                               (list (* w 0.15)      len)
                               (list 0               (* len 0.95))
                               (list (* w -0.4)      (* len 0.50)))))
        (rotate :shape (extrude :profile profile :height (* len 0.04))
                :axis :x :angle #a(90 :deg))))))

;; ── rachis: a straight cylinder along Z ──
(defun rachis (len thick)
  (translate :shape (cylinder :radius thick :height len)
             :by (list 0.0 0.0 (/ len 2.0))))

;; ── placement plist: alternating sides, scaled smaller toward tip ──
(defun pinna-placements (n len)
  (mapcar (lambda (i)
            (let* ((tt   (/ (+ i 1.0) (+ n 1.0)))
                   (side (if (= (mod i 2) 0) 1.0 -1.0)))
              (list :z     (* tt len 0.92)
                    :angle (deg (* side (- 70.0 (* tt 30.0))))
                    :scale (* (- 1.0 (* tt 0.55)) (* len 0.18)))))
          (iota n)))

;; ── place a single shape according to one plist ──
(defun place-one (shape p)
  (translate
    :shape (rotate :shape (scale :shape shape :factor (getf p :scale))
                   :axis :y :angle (getf p :angle))
    :by (list 0.0 0.0 (getf p :z))))

(rotate
  :shape (union (rachis 12.0 0.14)
                (apply union
                  (mapcar (lambda (p) (place-one (pinna 1.0) p))
                          (pinna-placements 13 12.0))))
  :axis :y :angle #a(-15 :deg))
