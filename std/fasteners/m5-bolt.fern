;;;; m5-bolt.fern
;;;; JIS B 1176 M5 hex socket cap screw

(defvar +m5-nominal-diameter+ 5.0)
(defvar +m5-head-height+ 5.0)
(defvar +m5-head-across-flats+ 8.5)

(defpart m5-bolt
  "JIS B 1176 M5 hex socket cap screw.

   PARAMS:
     length : total length including head (mm)"

  :meta (:category :fastener
         :standard "JIS B 1176"
         :material :steel
         :description "M5 hex socket cap screw")

  :params ((length :: length :default 25.0 :doc "total length (mm)"))

  :faces ((:head-top "head top")
          (:head-bottom "bearing surface")
          (:tip "tip"))

  :axes ((:center "bolt center axis"))

  :body
  (let* ((head (prism :sides 6
                      :radius (/ +m5-head-across-flats+ 2.0)
                      :height +m5-head-height+))
         (shaft-length (- length +m5-head-height+))
         (shaft (cylinder :radius (/ +m5-nominal-diameter+ 2)
                          :height shaft-length))
         (shaft-placed (translate :shape shaft
                                  :by (list 0.0 0.0 (- 0 +m5-head-height+)))))
    (union head shaft-placed)))

(export m5-bolt)
